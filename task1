/* ============================================================
 *                       ОБЩИЕ ФУНКЦИИ
 * ============================================================ */
void inputArray(int array[], int size)
{
    printf("Введите %d целых чисел через пробел:\n", size);
    for (int i = 0; i < size; ++i)
    {
        if (scanf("%d", &array[i]) != 1)
        {
            printf("Ошибка ввода элемента #%d. Завершение.\n", i + 1);
            exit(1);
        }
    }
}


void printArray(const int array[], int size)
{
    printf("[ ");
    for (int i = 0; i < size; ++i)
    {
        printf("%d ", array[i]);
    }
    printf("]\n");
} 
int findMin(const int array[], int size)
{
    int idx = 0;
    for (int i = 1; i < size; ++i)
    {
        if (array[i] < array[idx])
            idx = i;
    }
    return idx;
}


int findMax(const int array[], int size)
{
    int idx = 0;
    for (int i = 1; i < size; ++i)
    {
        if (array[i] > array[idx])
            idx = i;
    }
    return idx;
}


long long calculateSum(const int array[], int size)
{
    long long sum = 0;
    for (int i = 0; i < size; ++i)
        sum += array[i];

    return sum;
}


double calculateAverage(const int array[], int size)
{
    return (double)calculateSum(array, size) / size;
}


void printStatistics(const int array[], int size)
{
    int idxMin = findMin(array, size);
    int idxMax = findMax(array, size);

    long long sum = calculateSum(array, size);
    double avg = calculateAverage(array, size);

    int pos = 0, neg = 0, zero = 0;
    int even = 0, odd = 0;
    for (int i = 0; i < size; ++i)
    {
        if (array[i] > 0)       pos++; 

        else if (array[i] < 0)  neg++;
        else                    zero++;

        if (array[i] % 2 == 0)  even++;
        else                    odd++; 
    }

    printf("\n--- Статистика ---\n");
    printf("Минимум: %d (первый индекс %d)\n", array[idxMin], idxMin);
    printf("Максимум: %d (первый индекс %d)\n", array[idxMax], idxMax);
    printf("Сумма: %lld\n", sum);
    printf("Среднее арифметическое: %.4f\n", avg);
    printf("Положительных: %d, отрицательных: %d, нулей: %d\n",
           pos, neg, zero);
    printf("Чётных: %d, нечётных: %d\n", even, odd);
}


void printInRange(const int array[], int size)
{
    int a = 0, b = 0;

    printf("\nВведите границы диапазона [a b]: ");

    if (scanf("%d %d", &a, &b) != 2)
    {
        printf("Ошибка ввода диапазона.\n");
        return;
    }
    int lo = (a < b) ? a : b;
    int hi = (a < b) ? b : a;

    printf("Элементы в диапазоне [%d, %d]: ", lo, hi);

  
    int found = 0;

    for (int i = 0; i < size; ++i)
    {
        if (array[i] >= lo && array[i] <= hi)
        {
            printf("%d ", array[i]);
            found = 1;
        }
    }
    if (!found) printf("нет элементов");

    printf("\n");
}


/* ============================================================
 *         ИНДИВИДУАЛЬНОЕ ЗАДАНИЕ — ВАРИАНТ 2
 *
 *  Найти наибольший и второй по величине РАЗЛИЧНЫЕ элементы.
 *  Если различных значений меньше двух — вывести сообщение.
 * ============================================================ */
void findTwoLargestDistinct(const int array[], int size)
{
    int first  = INT_MIN;
    int second = INT_MIN;

    int hasFirst  = 0;
    int hasSecond = 0;
    for (int i = 0; i < size; ++i)
    {
        if (!hasFirst || array[i] > first)
        {
            if (hasFirst && array[i] != first)
            {
                second    = first;
                hasSecond = 1;
            }

            /* Новый first. */
            first    = array[i];
            hasFirst = 1;
        }
        else if (array[i] != first &&
                 (!hasSecond || array[i] > second))
        {
            second    = array[i];
            hasSecond = 1;
        }
    }

    if (!hasFirst || !hasSecond)
    {
        printf("В массиве недостаточно различных значений "
               "для поиска двух наибольших.\n");
    }
    else
    {
        printf("Наибольший элемент: %d\n", first);
        printf("Второй по величине (различный): %d\n", second);
    }
}
