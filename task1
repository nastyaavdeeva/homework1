#include <stdio.h>
#include <stdlib.h>
#include <limits.h>

#define MAX_SIZE 100

/* Прототипы функций */
void inputArray(int array[], int size);
void printArray(const int array[], int size);
int findMin(const int array[], int size);
int findMax(const int array[], int size);
long long calculateSum(const int array[], int size);
double calculateAverage(const int array[], int size);
void printStatistics(const int array[], int size);
void printInRange(const int array[], int size);
void findTwoLargestDistinct(const int array[], int size);

int main(void) 
{
    int array[MAX_SIZE];
    int size = 0;

    printf("=========================================\n");
    printf(" Обработка одномерного массива (C)\n");
    printf(" Вариант 2: два наибольших элемента\n");
    printf("=========================================\n\n"); 

    printf("Введите размер массива от 1 до %d: ", MAX_SIZE);
    if (scanf("%d", &size) != 1 || size < 1 || size > MAX_SIZE) 
    {
        printf("Ошибка: недопустимый размер массива.\n");
        return 1;
    }

    inputArray(array, size);

    printf("\nИсходный массив:\n");
    printArray(array, size);

    /* Статистика (минимум, максимум, сумма, среднее) */
    printStatistics(array, size);

    /* Вывод элементов в диапазоне */
    printInRange(array, size);

    printf("\n----- Индивидуальное задание (вариант 2) -----\n");
    findTwoLargestDistinct(array, size);

    return 0;
}

/* ============================================================
 *                       ОБЩИЕ ФУНКЦИИ
 * ============================================================ */

/* Ввод элементов массива с клавиатуры */
void inputArray(int array[], int size) 
{
    printf("Введите %d элементов массива:\n", size);
    for (int i = 0; i < size; i++) 
    {
        printf("array[%d] = ", i);
        if (scanf("%d", &array[i]) != 1) 
        {
            printf("Ошибка ввода! Установлено значение 0.\n");
            array[i] = 0;
            // Очистка буфера ввода в случае некорректного символа
            while (getchar() != '\n'); 
        }
    }
}

/* Вывод массива на экран */
void printArray(const int array[], int size) 
{
    for (int i = 0; i < size; i++) 
    {
        printf("%d ", array[i]);
    }
    printf("\n");
}

/* Поиск минимального элемента */
int findMin(const int array[], int size) 
{
    int min = array[0];
    for (int i = 1; i < size; i++) 
    {
        if (array[i] < min) 
        {
            min = array[i];
        }
    }
    return min;
}

/* Поиск максимального элемента */
int findMax(const int array[], int size) 
{
    int max = array[0];
    for (int i = 1; i < size; i++) 
    {
        if (array[i] > max) 
        {
            max = array[i];
        }
    }
    return max;
}

/* Подсчет суммы элементов (long long во избежание переполнения) */
long long calculateSum(const int array[], int size) 
{
    long long sum = 0;
    for (int i = 0; i < size; i++) 
    {
        sum += array[i];
    }
    return sum;
}

/* Подсчет среднего арифметического */
double calculateAverage(const int array[], int size) 
{
    if (size == 0) return 0.0;
    return (double)calculateSum(array, size) / size;
}

/* Вывод собранной статистики */
void printStatistics(const int array[], int size) 
{
    printf("\n--- Статистика массива ---\n");
    printf("Минимум: %d\n", findMin(array, size));
    printf("Максимум: %d\n", findMax(array, size));
    printf("Сумма: %lld\n", calculateSum(array, size));
    printf("Среднее арифметическое: %.2f\n", calculateAverage(array, size));
}

/* Пример реализации вывода элементов в заданном пользователем диапазоне индексов */
void printInRange(const int array[], int size) 
{
    int start, end;
    printf("\nВведите диапазон индексов для вывода (от 0 до %d) через пробел: ", size - 1);
    if (scanf("%d %d", &start, &end) == 2) 
    {
        if (start < 0 || end >= size || start > end) 
        {
            printf("Ошибка: неверный диапазон индексов.\n");
        } 
        else 
        {
            printf("Элементы в диапазоне от %d до %d: ", start, end);
            for (int i = start; i <= end; i++) 
            {
                printf("%d ", array[i]);
            }
            printf("\n");
        }
    }
}

/* Индивидуальное задание: 2 наибольших РАЗЛИЧНЫХ элемента */
void findTwoLargestDistinct(const int array[], int size) 
{
    int max1 = INT_MIN;
    int max2 = INT_MIN;
    int found_any = 0; 
    
    // Сначала находим абсолютный максимум
    for (int i = 0; i < size; i++) 
    {
        if (array[i] > max1) 
        {
            max1 = array[i];
            found_any = 1;
        }
    }

    // Ищем второй максимум, который строго меньше первого
    int found_second = 0;
    for (int i = 0; i < size; i++) 
    {
        if (array[i] < max1 && array[i] > max2) 
        {
            max2 = array[i];
            found_second = 1;
        }
    }

    if (!found_any || !found_second) 
    {
        printf("Сообщение: В массиве нет двух различных элементов.\n");
    } 
    else 
    {
        printf("Первый наибольший элемент: %d\n", max1);
        printf("Второй наибольший (различный) элемент: %d\n", max2);
    }
}
